            <substate>
              <selfDestruct> .Set </selfDestruct>
              <log> .List => @@COMPLETE_LOG_LIST_K@@ </log>
              <refund> 0 </refund>
              <accessedAccounts> .Set => @@ACCESSED_ACCOUNTS_K@@ </accessedAccounts>
              <accessedStorage> .Map => @@ACCESSED_STORAGE_K@@ </accessedStorage>
              <createdAccounts> .Set </createdAccounts>
            </substate>
            <gasPrice> 0 </gasPrice>
            <origin> .Account => @@SENDER_INT@@ </origin>
            <block>
              <coinbase> 0 </coinbase>
              <gasLimit> @@BLOCK_GAS_LIMIT_INT@@ </gasLimit>
              <gasUsed> 0:Gas </gasUsed>
              <baseFee> 0 </baseFee>
              <timestamp> @@TIMESTAMP_INT@@ </timestamp>
              <number> @@BLOCK_NUMBER_INT@@ </number>
              ...
            </block>
            ...
          </evm>
          <network>
            <chainID> 31337 </chainID>
            <accounts> @@PRE_ACCOUNTS_K@@ => @@POST_ACCOUNTS_K@@ </accounts>
            <txOrder> .List </txOrder>
            <txPending> ListItem(0) => .List </txPending>
            <messages>
              <message>
                <msgID> 0 </msgID>
                <txNonce> @@SENDER_NONCE_BEFORE_INT@@ </txNonce>
                <txGasPrice> 0 </txGasPrice>
