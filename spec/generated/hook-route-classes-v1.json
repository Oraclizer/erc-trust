  "specClasses": [
    {
      "name": "Route_Hook_Balance_Callback",
      "mutating": true,
      "definition": "The post-balance callback of the endpoint, called by the bound Compliance module after an upstream balance change; it brings the upstream frozen amount of the touched accounts to their owned targets saturated at the new balances and records the applied amount."
    },
    {
      "name": "Route_Compliance_Callback",
      "mutating": true,
      "definition": "An ERC-3643 Compliance hook that the bound token calls after a mint, a transfer or a burn; once the endpoint is set, its only effect is to forward the touched accounts to the balance callback of the endpoint."
    },
    {
      "name": "Route_Compliance_Setup",
      "mutating": true,
      "definition": "A one-time binding or activation step of the Compliance module that the construction of the unit performs exactly once; every later call reverts."
    },
    {
      "name": "Route_Compliance_View",
      "mutating": false,
      "definition": "A view or pure function of the Compliance module, including the pure unbinding entrypoint that always reverts."
    },
    {
      "name": "Route_Unit_Creation",
      "mutating": true,
      "definition": "Creation of a new conformance unit by the factory; it writes no storage of an existing unit."
    }
  ],
