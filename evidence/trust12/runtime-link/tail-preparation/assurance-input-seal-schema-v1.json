{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trust12-tail-preparation-assurance-input-seal-v1",
  "title": "Frozen inputs of the independent Assurance of the TRUST 1.2 runtime link",
  "description": "A seal names every input that the independent Assurance may read, by root alias and relative path, with its size and SHA-256. Verification recomputes each file set from the recorded selectors, so a modified, added or removed file fails. The seal carries the reproduction commands and the four independent checks of the central refinement closure. It is not an Assurance result.",
  "type": "object",
  "required": [
    "schema", "status", "rootAliases", "rootInventory", "product", "bundles", "sealRootSha256",
    "toolchain", "reproduction", "assuranceChecks", "reuse", "exclusions", "nonclaim"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "trust12-tail-preparation-assurance-input-seal-v1"},
    "status": {
      "description": "A dry run exercises the format on current inputs and is never an Assurance input.",
      "enum": ["TEMPLATE_DRY_RUN", "SEALED_FOR_INDEPENDENT_ASSURANCE"]
    },
    "rootAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/alias"}
    },
    "rootInventory": {
      "type": "object",
      "additionalProperties": {"enum": ["git-tracked", "walk"]}
    },
    "product": {
      "type": "object",
      "required": ["remote", "commit", "tree", "cleanWorktree"],
      "additionalProperties": false,
      "properties": {
        "remote": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"},
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"},
        "cleanWorktree": {"type": "boolean"}
      }
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "centralClosureRole", "description", "selectors", "fileCount", "rootSha256", "files"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "centralClosureRole": {
            "enum": [
              "abstract authority",
              "normative authority",
              "implementation target",
              "compiled target",
              "product consumer",
              "runtime-link evidence",
              "reproduction tooling",
              "remaining tracked files"
            ]
          },
          "description": {"type": "string", "minLength": 1},
          "selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector"}},
          "fileCount": {"type": "integer", "minimum": 0},
          "rootSha256": {"$ref": "#/$defs/sha256"},
          "files": {"type": "array", "items": {"$ref": "#/$defs/fileRecord"}}
        }
      }
    },
    "sealRootSha256": {"$ref": "#/$defs/sha256"},
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "pin", "declaredIn", "declarationText"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "pin": {"type": "string", "minLength": 1},
          "declaredIn": {"$ref": "#/$defs/fileLocation"},
          "declarationText": {
            "description": "Exact text that the declaring file must contain; the verifier checks it.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reproduction": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "workingRoot", "command", "passCriterion", "coldReplay"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "purpose": {"type": "string", "minLength": 1},
          "workingRoot": {"$ref": "#/$defs/alias"},
          "command": {"type": "string", "minLength": 1},
          "passCriterion": {"type": "string", "minLength": 1},
          "coldReplay": {"type": "boolean"}
        }
      }
    },
    "assuranceChecks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "question", "inputs", "procedure", "passCriterion", "onFailure"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "reconstruct-from-frozen-specification",
              "reverse-enumerate-obligations",
              "reproduce-removal-negatives",
              "recompute-central-artifact"
            ]
          },
          "question": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
          "procedure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "passCriterion": {"type": "string", "minLength": 1},
          "onFailure": {"type": "string", "minLength": 1}
        }
      }
    },
    "reuse": {
      "type": "object",
      "required": ["policy", "conditions", "coldReplayRequiredFor"],
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string", "minLength": 1},
        "conditions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "coldReplayRequiredFor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonclaim": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "alias": {"type": "string", "pattern": "^[A-Z][A-Z_]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relativePath": {"type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\.\\.)[^\\\\]+$"},
    "fileLocation": {
      "type": "object",
      "required": ["root", "path"],
      "additionalProperties": false,
      "properties": {
        "root": {"$ref": "#/$defs/alias"},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "fileRecord": {
      "type": "object",
      "required": ["root", "path", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "root": {"$ref": "#/$defs/alias"},
        "path": {"$ref": "#/$defs/relativePath"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["root", "include"],
          "additionalProperties": false,
          "properties": {
            "root": {"$ref": "#/$defs/alias"},
            "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "allowEmpty": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "required": ["root", "remainder"],
          "additionalProperties": false,
          "properties": {
            "root": {"$ref": "#/$defs/alias"},
            "remainder": {"const": true},
            "allowEmpty": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "required": ["root", "ledger", "runFiles"],
          "additionalProperties": false,
          "properties": {
            "root": {"$ref": "#/$defs/alias"},
            "ledger": {"$ref": "#/$defs/relativePath"},
            "runFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "optionalRunFiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "rootFiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "followSessionDirectories": {"type": "boolean"},
            "allowEmpty": {"type": "boolean"}
          }
        }
      ]
    }
  }
}
